# Fixed admin account: admin / 123456
# AI providers are managed in the web UI, cc-switch style.
# Add OpenAI-compatible, OpenRouter, DeepSeek, Groq, SenseNova or any custom provider from /AI 供应商.
# Queue
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2
# Local storage custom path. Use an absolute path, or relative to the repo root.
STORAGE_PATH=./storage
UPLOADS_PATH=./storage/uploads
VIDEO_OUT_PATH=./storage/videos
# Local FFmpeg. This project defaults to E:/FFmpeg if the file exists.
FFMPEG_PATH=E:/FFmpeg/ffmpeg.exe
FFMPEG_FFPROBE_PATH=E:/FFmpeg/ffprobe.exe
# Server
PORT=3001
PUBLIC_URL=http://localhost:5173

# Cloud PostgreSQL (TiDB Cloud, pg-compatible endpoint; TLS uses Node's bundled
# root store — no custom CA needed). For a local dev DB append ?sslmode=disable.
DATABASE_URL=postgresql://<cluster>.<user>:<url-encoded-password>@<cluster>.gateway01.<region>.prod.aws.pg.tidbcloud.com:5432/postgres
# Optional: a throwaway database used by npm test only. Falls back to DATABASE_URL when unset.
# TEST_DATABASE_URL=postgresql://postgres:<url-encoded-password>@localhost:5433/slenk_notes_test?sslmode=disable
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# TiDB Cloud Data Service API key pair (HTTP Data API, Basic auth). The app
# itself connects via pg on 5432 and does not read these.
TIDB_API_PUBLIC_KEY=
TIDB_API_PRIVATE_KEY=
