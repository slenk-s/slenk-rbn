# API Provider Key
OPENAI_API_KEY=
# Optional: override OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Text / rewrite models
TEXT_MODEL=deepseek-v4-pro
# Image models, OpenAI-compatible when possible
IMAGE_MODEL=gpt-image-1
# Storage: local disk unless you run MinIO and set S3_* env vars
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Queue worker
QUEUE_TOKEN=change-me
QUEUE_CONCURRENCY=2
PORT=3001
PUBLIC_URL=http://localhost:5173
