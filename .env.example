# Fixed admin account: admin / 123456
# AI providers are managed in the web UI, cc-switch style.
# Add OpenAI-compatible, OpenRouter, DeepSeek, Groq, SenseNova or any custom provider from /AI 供应商.
# Queue
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2
# Local storage custom path. Use an absolute path, or relative to the repo root.
STORAGE_PATH=./storage
UPLOADS_PATH=./storage/uploads
VIDEO_OUT_PATH=./storage/videos
# Data layer: SQLite 是唯一后端（MySQL 已移除）。
# SQLite file and media bytes directory (defaults under STORAGE_PATH).
# SQLITE_PATH=./storage/slenk.sqlite
# MEDIA_DIR=./storage/media
# Local FFmpeg. This project defaults to E:/FFmpeg if the file exists.
FFMPEG_PATH=E:/FFmpeg/ffmpeg.exe
FFMPEG_FFPROBE_PATH=E:/FFmpeg/ffprobe.exe
# Server
PORT=3001
PUBLIC_URL=http://localhost:5173

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (login bot protection). TURNSTILE_SECRET is the widget
# secret from the Cloudflare dashboard (never commit a real value). Local dev
# must allow the exact frontend hostnames; siteverify returns the hostname
# without a port. A production value must NOT include localhost/127.0.0.1.
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# TiDB Cloud Data Service API key pair (HTTP Data API, Basic auth). The app
# itself connects via pg on 5432 and does not read these.
TIDB_API_PUBLIC_KEY=
TIDB_API_PRIVATE_KEY=
