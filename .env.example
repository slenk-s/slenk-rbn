# Admin account is fixed: admin / 123456
# SenseNova AI provider defaults
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://platform.sensenova.cn/v1
SENSENOVA_TEXT_MODEL=Sensenova-6.8-Flash-Lite
SENSENOVA_IMAGE_MODEL=gpt-image-1
# Queue
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2
# Local storage custom path
STORAGE_PATH=./storage
UPLOADS_PATH=./storage/uploads
VIDEO_OUT_PATH=./storage/videos
# Server
PORT=3001
PUBLIC_URL=http://localhost:5173
